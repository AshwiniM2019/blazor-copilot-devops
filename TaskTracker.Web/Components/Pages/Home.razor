@page "/"
@rendermode InteractiveServer
@using TaskTracker.Web.Services
@using TaskTracker.Web.Models
@inject TaskService TaskService

<h3>Team Task Tracker</h3>

<div class="mb-3">
    <div class="row g-2">
        <div class="col-auto">
            <input @bind="_newTitle" placeholder="New task title..." class="form-control" />
        </div>
        <div class="col-auto">
            <select @bind="_selectedPriority" class="form-select">
                <option value="@TaskPriority.Low">Low</option>
                <option value="@TaskPriority.Medium">Medium</option>
                <option value="@TaskPriority.High">High</option>
            </select>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="AddTask">Add</button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <p class="text-danger">@_error</p>
}

<ul class="list-group">
    @foreach (var task in TaskService.GetAll())
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>@task.Title</span>
            <span class="badge @GetPriorityCssClass(task.Priority)">@task.Priority</span>
        </li>
    }
</ul>

@code {
    private string _newTitle = string.Empty;
    private string? _error;
    private TaskPriority _selectedPriority = TaskPriority.Medium;

    private void AddTask()
    {
        try
        {
            _error = null;
            TaskService.Add(_newTitle, _selectedPriority);
            _newTitle = string.Empty;
            _selectedPriority = TaskPriority.Medium;
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
    }

    private string GetPriorityCssClass(TaskPriority priority) => priority switch
    {
        TaskPriority.Low => "bg-info",
        TaskPriority.Medium => "bg-warning",
        TaskPriority.High => "bg-danger",
        _ => "bg-secondary"
    };
}